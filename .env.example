PORT=3000

# Provider order: groq,gemini,mistral,openrouter
PROVIDER_ORDER=groq,gemini,mistral,openrouter

# Required: private key protecting the public chat endpoint
ROUTER_API_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional identification headers for OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=StarNet Free API Router
